DD1_GAME_DIR=C:\Program Files (x86)\Steam\steamapps\common\DarkestDungeon\_windows\win64
DD1_BLINDEST_LOG=C:\Program Files (x86)\Steam\steamapps\common\DarkestDungeon\_windows\win64\ddaccess-debug.log
DD1_SAVE_DIR=C:\Program Files (x86)\Steam\userdata\<steam-account>\262060\remote\profile_2
DD1_SAVE_EDITOR_JAR=C:\path\to\DDSaveEditor.jar
DD1_JAVA_EXECUTABLE=C:\path\to\java.exe
DD1_COMMAND_PIPE=\\.\pipe\dd1-agent-bridge
# Stable campaign key. If omitted, the save directory name (for example profile_2) is used.
DD1_CAMPAIGN_ID=profile_2
# Keep the live SQLite/WAL files outside cloud-synchronized project folders.
DD1_MEMORY_DB=C:\Users\<user>\AppData\Local\DD1AgentBridge\campaigns\profile_2\campaign.sqlite
